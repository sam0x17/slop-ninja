# systemd user unit template for a continuous, dispatching Slop Ninja
# validator. Instance %i selects ~/.config/slop_ninja_validator/%i.toml, which
# must have [package] and [dispatch], and normally [fetch].
#
# Each start runs recovery, the commit/reveal check, a fetch from the public
# status host, package verification and then journaled dispatch, re-committing
# the active target once per tempo. With dispatch.max_finalized_blocks unset
# the run is continuous: it continues on a fetched successor target in the
# same process and waits out a deferred tempo without exiting, so it exits
# only on an error (1), on recovery that cannot finish yet or work awaiting
# recovery (75), or on a check (3). Exits 2 (configuration) and 3 (a check
# halted the run) need the operator and are not restarted; after fixing the
# cause, `systemctl --user reset-failed` and start the unit again. Install
# with deploy/install.sh; lingering keeps the unit running without a login
# session and starts it at boot.
#
# The restart delay is fixed. systemd's RestartSteps backoff never resets
# while the unit keeps being restarted automatically (each restart, of any
# exit code, counts), so it would leave every later restart at its maximum.

[Unit]
Description=Slop Ninja native validator dispatch (%i)
# Validators retry indefinitely; a stalled dependency must not disable the unit.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/env -i HOME=%h RUST_BACKTRACE=0 %h/.local/bin/slop_ninja_validator --config %h/.config/slop_ninja_validator/%i.toml run --dispatch
Restart=always
RestartSec=60
# 2: invalid configuration. 3: a check halted the run (operator action).
RestartPreventExitStatus=2 3
# SIGTERM pauses the journal and exits; retained work survives the restart.
KillSignal=SIGTERM
TimeoutStopSec=90
# Twice the measured worst case at the receipt index bound, rounded up to a
# whole GiB (README, fetch_tests::peak_memory_at_the_receipt_index_bound).
MemoryMax=2G
MemorySwapMax=0
# Isolation. The user manager passes its own environment to every unit (on an
# operator host that can include API keys and agent sockets), so ExecStart
# starts the validator through `env -i` with only HOME and RUST_BACKTRACE.
# An Environment= or EnvironmentFile= setting added to this unit therefore
# never reaches the validator (README, "Isolation"; a drill passes its
# fault explicitly, README "Fault-injection hooks").
# The settings below need no namespace, so they work in user units even
# where unprivileged user namespaces are restricted (Ubuntu's AppArmor
# default; there ProtectHome=, PrivateTmp=, BindPaths= and the other mount
# settings fail the unit with exit 226). Without AF_UNIX the validator can
# reach no local socket: not the session bus (so no transient unit outside
# these limits), an agent, or a container daemon. File isolation comes from
# the bubblewrap drop-in deploy/install.sh writes (sandbox-unit), or from a
# Unix user of its own (README, "Isolation").
# The log identifier stays the validator's, not env's or bwrap's.
SyslogIdentifier=slop_ninja_validator
NoNewPrivileges=yes
UMask=0077
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
KeyringMode=private
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
