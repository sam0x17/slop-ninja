      <pgterms:agent rdf:about="2009/agents/102">
        <pgterms:name>Alcott, Louisa May</pgterms:name>
        <pgterms:birthdate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1832</pgterms:birthdate>
        <pgterms:deathdate rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1888</pgterms:deathdate>
        <pgterms:alias>Barnard, A. M.</pgterms:alias>
