# systemd user unit template for the Slop Ninja native validator.
# Instance %i selects ~/.config/slop_ninja_validator/%i.toml.
# A dry run: verifies the package and prints the unsigned commit, never signs.
# Install with deploy/install.sh. Requires lingering for the user.

[Unit]
Description=Slop Ninja native validator (%i)
# Validators retry indefinitely; a stalled dependency must not disable the unit.
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=%h/.local/bin/slop_ninja_validator --config %h/.config/slop_ninja_validator/%i.toml run
Restart=on-failure
RestartSec=120
RestartSteps=4
RestartMaxDelaySec=30min
# 2: invalid configuration. 3: a policy check halted startup (operator action).
RestartPreventExitStatus=2 3
# SIGTERM interrupts startup; the journal is already paused.
KillSignal=SIGTERM
TimeoutStopSec=60
# Twice the measured worst case at the receipt index bound, rounded up to a
# whole GiB (README, fetch_tests::peak_memory_at_the_receipt_index_bound).
MemoryMax=2G
MemorySwapMax=0
UMask=0077
NoNewPrivileges=yes
Environment=RUST_BACKTRACE=0

[Install]
WantedBy=default.target
